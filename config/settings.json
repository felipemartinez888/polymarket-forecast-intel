{
  "calc_version": "1.0.0",
  "endpoints": {
    "gamma": "https://gamma-api.polymarket.com",
    "clob": "https://clob.polymarket.com"
  },
  "http": {
    "timeout_seconds": 30,
    "max_retries": 5,
    "backoff_base_seconds": 1.5,
    "min_interval_seconds": 0.25,
    "user_agent": "polymarket-forecast-intel/1.0 (read-only research)"
  },
  "discovery": {
    "search_queries": [
      "fed",
      "fomc",
      "fed rate",
      "fed decision",
      "interest rates",
      "rate cut",
      "rate hike",
      "fed chair",
      "clarity act",
      "market structure",
      "crypto bill",
      "stablecoin",
      "genius act",
      "sec crypto",
      "cftc crypto",
      "bitcoin etf",
      "ethereum etf",
      "crypto etf",
      "strategic bitcoin reserve",
      "cpi",
      "inflation",
      "pce",
      "jobs report",
      "nonfarm payrolls",
      "unemployment rate",
      "recession",
      "gdp"
    ],
    "max_search_pages": 5,
    "search_limit_per_type": 50,
    "tag_slugs": [
      "fed",
      "fed-rates",
      "economy",
      "economic-policy",
      "crypto-policy",
      "inflation"
    ],
    "max_tag_pages": 10,
    "page_size": 100,
    "earliest_end_date": "2023-01-01T00:00:00Z"
  },
  "history": {
    "fidelity_minutes": 60,
    "chunk_days": 7,
    "max_points_per_market": 40000,
    "run_budget_seconds": 2700,
    "backfill_priority": [
      "fomc_decision",
      "clarity_act",
      "stablecoin",
      "market_structure",
      "government_policy",
      "agency_action",
      "etf_decision",
      "rate_path",
      "emergency_action",
      "leadership",
      "cpi",
      "core_cpi",
      "pce",
      "nonfarm_payrolls",
      "unemployment",
      "gdp",
      "recession",
      "treasury_liquidity"
    ]
  },
  "horizons": [
    {
      "key": "30d",
      "seconds": 2592000,
      "max_staleness_seconds": 172800
    },
    {
      "key": "14d",
      "seconds": 1209600,
      "max_staleness_seconds": 172800
    },
    {
      "key": "7d",
      "seconds": 604800,
      "max_staleness_seconds": 86400
    },
    {
      "key": "3d",
      "seconds": 259200,
      "max_staleness_seconds": 43200
    },
    {
      "key": "24h",
      "seconds": 86400,
      "max_staleness_seconds": 21600
    },
    {
      "key": "final",
      "seconds": 0,
      "max_staleness_seconds": 86400
    }
  ],
  "final_buffer_seconds": 60,
  "settlement_band": 0.05,
  "metrics": {
    "log_loss_clip": 0.01,
    "directional_threshold": 0.5,
    "no_call_band": 0.05,
    "calibration_bins": 10,
    "min_bin_n_for_inference": 10,
    "bootstrap_samples": 2000,
    "random_seed": 20260101,
    "min_events_for_trend_point": 5
  },
  "shifts": {
    "pp_threshold_24h": 10,
    "pp_threshold_7d": 15,
    "tolerance_24h_seconds": 21600,
    "tolerance_7d_seconds": 86400,
    "min_base_for_relative": 0.01
  },
  "storage": {
    "max_runs_logged": 300,
    "snapshot_partition": "month"
  }
}
