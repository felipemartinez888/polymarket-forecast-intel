{
  "_doc": "Rules are evaluated in order against the lower-cased text '<event title> || <market question> || <groupItemTitle>'. The first rule whose `any` pattern matches, whose `all` patterns all match, and none of whose `none` patterns match, assigns the category. Every assignment records the rule id so classification is auditable. Manual overrides in overrides.json win over rules.",
  "version": "1.0.0",
  "rules": [
    {
      "id": "crypto_price_direction",
      "category": "crypto_price",
      "subcategory": "price_direction",
      "relevance": "low",
      "any": ["\\b(bitcoin|btc|ethereum|eth|solana|sol|xrp|dogecoin|doge|cardano|bnb|hyperliquid|hype)\\b"],
      "all": ["(\\bprice\\b|\\babove\\b|\\bbelow\\b|\\breach\\b|\\bhit\\b|\\bdip\\b|up or down|all[- ]time high|\\$ ?\\d|\\d+k\\b|between \\$)"],
      "none": ["\\betf\\b", "\\breserve\\b", "\\bact\\b", "\\bbill\\b", "\\bsec\\b", "\\bcftc\\b"]
    },
    {
      "id": "fed_decision",
      "category": "fed",
      "subcategory": "fomc_decision",
      "relevance": "high",
      "any": ["\\bfed decision\\b", "\\bfomc\\b", "\\bfed (?:rate|interest rate)s?\\b", "\\bfed (?:cuts?|hikes?|raises?|lowers?|pauses?)\\b", "\\bfederal reserve\\b.*\\b(rate|cut|hike|decision)\\b"],
      "all": ["(decision|bps|basis points|no change|cut|hike|increase|decrease|raise|lower|pause|unchanged|hold)"],
      "none": ["how many", "number of", "chair", "nominat", "emergency"]
    },
    {
      "id": "fed_rate_count",
      "category": "fed",
      "subcategory": "rate_path",
      "relevance": "high",
      "any": ["\\bfed\\b", "\\bfomc\\b", "federal reserve"],
      "all": ["(how many|number of|cuts in 20\\d\\d|hikes in 20\\d\\d|upper bound|target range|fed funds)"],
      "none": ["chair", "nominat"]
    },
    {
      "id": "fed_emergency",
      "category": "fed",
      "subcategory": "emergency_action",
      "relevance": "high",
      "any": ["\\bfed\\b.*emergency", "emergency.*\\b(rate cut|fed)\\b"],
      "all": [],
      "none": []
    },
    {
      "id": "fed_leadership",
      "category": "fed",
      "subcategory": "leadership",
      "relevance": "high",
      "any": ["fed chair", "federal reserve chair", "\\bfed governor", "powell", "chair of the fed"],
